{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{checkpoint}}"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt:}}",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "{{width:1024}}",
      "height": "{{height:1024}}",
      "batch_size": "{{batch_size:1}}"
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed:0}}",
      "steps": "{{steps:30}}",
      "cfg": "{{cfg:6.5}}",
      "sampler_name": "{{sampler:dpmpp_2m_sde}}",
      "scheduler": "{{scheduler:karras}}",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["5", 0],
      "vae": ["1", 2]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["6", 0],
      "filename_prefix": "{{output_prefix:max-comfy}}"
    }
  }
}
