{
  "1": {
    "class_type": "ImageOnlyCheckpointLoader",
    "inputs": {
      "ckpt_name": "{{checkpoint}}"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{input_image}}"
    }
  },
  "3": {
    "class_type": "SVD_img2vid_Conditioning",
    "inputs": {
      "clip_vision": ["1", 1],
      "init_image": ["2", 0],
      "vae": ["1", 2],
      "width": "{{width:1024}}",
      "height": "{{height:576}}",
      "video_frames": "{{frames:25}}",
      "motion_bucket_id": "{{motion_bucket_id:127}}",
      "fps": "{{fps:24}}",
      "augmentation_level": "{{augmentation:0.0}}"
    }
  },
  "4": {
    "class_type": "VideoLinearCFGGuidance",
    "inputs": {
      "model": ["1", 0],
      "min_cfg": "{{min_cfg:1.0}}"
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["3", 0],
      "negative": ["3", 1],
      "latent_image": ["3", 2],
      "seed": "{{seed:0}}",
      "steps": "{{steps:20}}",
      "cfg": "{{cfg:2.5}}",
      "sampler_name": "{{sampler:euler}}",
      "scheduler": "{{scheduler:karras}}",
      "denoise": 1.0
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["5", 0],
      "vae": ["1", 2]
    }
  },
  "7": {
    "class_type": "SaveAnimatedWEBP",
    "inputs": {
      "images": ["6", 0],
      "filename_prefix": "{{output_prefix:svd_segment}}",
      "fps": "{{fps:24}}",
      "lossless": false,
      "quality": "{{quality:90}}",
      "method": "default"
    }
  }
}
